{
  /* Cloudflare Worker runtime: workerd globals, no DOM. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@worker/*": ["./worker/*"]
    }
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../shared/**/*.test.ts"]
}
